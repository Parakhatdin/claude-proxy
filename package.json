{
  "name": "claude-proxy",
  "version": "0.1.0",
  "description": "Anthropic Messages API-compatible HTTP proxy backed by the local `claude -p` CLI",
  "type": "module",
  "bin": { "claude-proxy": "./dist/index.js" },
  "main": "./dist/index.js",
  "engines": { "node": ">=20.10" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "files": ["dist", "README.md"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
