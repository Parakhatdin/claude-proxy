# Bind address. Keep it on loopback unless you also set an API key.
CLAUDE_PROXY_HOST=127.0.0.1
CLAUDE_PROXY_PORT=8787

# Shared secret callers must send as `x-api-key` or `Authorization: Bearer`.
# Unset means no auth: anything that can reach the port can spend your Claude quota.
CLAUDE_PROXY_API_KEY=

# clean = plain model API (no tools, no CLAUDE.md, no MCP).
# agent = full Claude Code agent with tools and project context.
CLAUDE_PROXY_MODE=clean

CLAUDE_PROXY_DEFAULT_MODEL=sonnet
CLAUDE_PROXY_DEFAULT_SYSTEM=You are Claude, a helpful AI assistant.

# agent mode only
CLAUDE_PROXY_CWD=/tmp
CLAUDE_PROXY_TOOLS=Read,Glob,Grep
CLAUDE_PROXY_PERMISSION_MODE=default

CLAUDE_PROXY_MAX_CONCURRENCY=4
CLAUDE_PROXY_QUEUE_LIMIT=32
CLAUDE_PROXY_TIMEOUT_MS=600000

CLAUDE_PROXY_SESSION_REUSE=1
CLAUDE_PROXY_ENFORCE_MAX_TOKENS=1
CLAUDE_PROXY_INCLUDE_THINKING=0
CLAUDE_PROXY_EXPOSE_TOOL_BLOCKS=0

CLAUDE_PROXY_LOG_LEVEL=info
CLAUDE_PROXY_CLAUDE_BIN=claude
